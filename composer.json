{
  "name": "tbd/tbd-component-bundle",
  "description": "A Symfony bundle containing a shared library of reusable Twig components.",
  "type": "symfony-bundle",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Tbd\\TbdComponentBundle\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Karel Scheers",
      "email": "karel@tbd.be"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": ">=6.4 <8.0",
    "symfony/config": ">=6.4 <8.0",
    "symfony/ux-twig-component": "^2.32",
    "symfony/stimulus-bundle": "^2.23",
    "ramsey/uuid-doctrine": "^2.1",
    "symfony/ux-icons": "^2.23",
    "symfony/flex": "^2",
    "symfony/options-resolver": "^8.0"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
