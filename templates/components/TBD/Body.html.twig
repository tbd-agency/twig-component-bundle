{% set attr = {
    'class': block('body_classes', tbd_twig_component_template)|trim,
    'data-controller': controllers,
} %}
{% if sidebar %}
    {% set attr = attr|merge({'data-sidebar-hover-state-value': sidebarHoverState}) %}
{% endif %}

<body{{ attributes.defaults(attr) }}>
{% block content %}{% endblock %}
</body>
