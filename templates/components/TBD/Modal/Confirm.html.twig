<div id="{{ id }}" tabindex="-1"
     class="fixed top-0 left-0 right-0 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full z-60">
    <div class="relative w-full max-w-md max-h-full">
        <div class="{{ block('modal_wrapper_classes', tbd_twig_component_template)|trim }}">
            <div class="{{ block('modal_header_classes', tbd_twig_component_template)|trim }}">
                <h3 class="{{ block('modal_header_title_classes', tbd_twig_component_template)|trim }}">
                    {% if title %}
                        {{ title }}
                    {% else %}
                        {{ 'sub-title.confirm'|trans({'default': 'Confirm'}, 'tbd-component') }}
                    {% endif %}
                </h3>
                <twig:TBD:Button
                        class="{{ block('modal_header_button_classes', tbd_twig_component_template)|trim }}"
                        data-target="{{ id }}"
                        data-action="modal#close"
                        variant="{{ closeButtonVariant }}" size="{{ closeButtonSize }}"
                        label="{{ ux_icon('tbd:x', {'class': 'w-4 h-4'}) }}"/>
            </div>
            <div class="{{ block('modal_content_classes', tbd_twig_component_template)|trim }}">
                <input type="hidden" name="_token">
                <twig:TBD:Modal:Content:Body>
                    <p class="{{ block('modal_content_message_classes', tbd_twig_component_template)|trim }}">
                        {% if message %}
                            {{ message }}
                        {% else %}
                            {{ 'label.confirm'|trans({'default': 'Are you sure you wish to continue?'}, 'tbd-component') }}
                        {% endif %}
                    </p>
                </twig:TBD:Modal:Content:Body>
                <twig:TBD:Modal:Content:Footer>
                    <div class="{{ block('modal_content_buttons_classes', tbd_twig_component_template)|trim }}">
                        <twig:TBD:Button
                                data-target="{{ id }}"
                                data-action="modal#close"
                                tag="a" class="confirm"
                                data-turbo-prefetch="false"
                                variant="{{ confirmButtonVariant }}" size="{{ confirmButtonSize }}"
                                label="{{ 'button.confirm'|trans({'default': 'Confirm'}, 'tbd-component') }}"/>
                        <twig:TBD:Button
                                data-target="{{ id }}"
                                data-action="modal#close"
                                variant="{{ cancelButtonVariant }}" size="{{ cancelButtonSize }}"
                                label="{{ 'button.cancel'|trans({'default': 'Cancel'}, 'tbd-component') }}"/>
                    </div>
                </twig:TBD:Modal:Content:Footer>
            </div>
        </div>
    </div>
</div>
