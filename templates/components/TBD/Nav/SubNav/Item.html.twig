<li{{ attributes }}>
    {% if block('content') is defined %}
        {{ block('content') }}
    {% elseif (path is defined and path) and (label is defined and label) %}
        <a href="{{ path }}" class="{{ block('nav_sub_nav_item_classes', tbd_twig_component_template)|trim }}">
            {{ label }}
        </a>
    {% endif %}
</li>
