<{{ tag }}
    {{ attributes.defaults({
        'aria-current': app.request.pathInfo == path ? 'page' : null,
        'class': block('nav_item_classes',tbd_twig_component_template)|trim,
    }) }}
    {% if tag == 'a' %} href="{{ path }}"{% endif %}
  {% if tooltip is defined and tooltip %}
      data-tooltip-target="{{ identifier }}"
      data-tooltip-placement="{{ tooltipPlacement }}"
  {% endif %}
>
<div class="flex items-center">
    {% if icon %}
        {{ ux_icon(icon, {class: block('nav_item_icon_classes', tbd_twig_component_template)|trim}) }}
    {% endif %}
    <span data-sidebar-target="collapseHide" class="{{ SidebarExpanded() ? '' : 'hidden' }}">{{ label }}</span>
</div>
{% if badge is defined and badge %}
    <span class="{{ this.getBadgeClasses ~ (SidebarExpanded() ? '' : ' hidden') }}"
          data-sidebar-target="collapseHide">{{ badge }}</span>
{% endif %}
</{{ tag }}>

{% if tooltip is defined and tooltip %}
    <div data-sidebar-target="collapseShow">
        <twig:TBD:Tooltip identifier="{{ identifier }}" label="{{ tooltip }}"/>
    </div>
{% endif %}
