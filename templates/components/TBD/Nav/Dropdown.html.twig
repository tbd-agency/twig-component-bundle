<div{{ attributes }}>
    <button type="button" aria-controls="{{ id }}"
            data-action="click->sidebar#dropdownToggle"
            data-sidebar-target="dropdownButton"
            aria-expanded="{{ this.isHidden ? 'false' : 'true' }}"
            class="{{ block('nav_dropdown_button_classes', tbd_twig_component_template)|trim }}"
            {% if tooltip is defined and tooltip %}
                data-controller="tooltip"
                data-tooltip-target-value="{{ identifier }}"
                data-tooltip-placement-value="{{ tooltipPlacement }}"
            {% endif %}>
        <div class="flex items-center">
            {% if icon %}
                {{ ux_icon(icon, {'class': block('nav_dropdown_button_icon_classes', tbd_twig_component_template)|trim }) }}
            {% endif %}
            <span class="{{ block('nav_dropdown_button_label_classes', tbd_twig_component_template)|trim ~ (sidebarExpanded() ? '' : ' hidden')}}"
                  data-sidebar-target="collapseHide">{{ label }}</span>
        </div>
        <div class="{{ block('nav_dropdown_down_icon_wrapper_classes', tbd_twig_component_template)|trim ~ (sidebarExpanded() ? '' : ' hidden')}}"
             data-sidebar-target="collapseHide">
            {{ ux_icon('tbd:angle-down', {class: block('nav_dropdown_down_icon_classes', tbd_twig_component_template)|trim  }) }}
            {% if badge is defined and badge %}
                <span class="{{ this.getBadgeClasses }}">{{ badge }}</span>
            {% endif %}
        </div>
    </button>
    <div data-sidebar-target="collapseHide" class="{{ sidebarExpanded() ? '' : 'hidden' }}">
        <ul id="{{ id }}" class="{% if this.isHidden %}hidden {% endif %}pt-2 space-y-2" data-sidebar-target="dropdownContent">
            {% block content %}{% endblock %}
        </ul>
    </div>
</div>

{% if tooltip is defined and tooltip %}
    <div data-sidebar-target="collapseShow">
        <twig:TBD:Tooltip identifier="{{ identifier }}" label="{{ tooltip }}"/>
    </div>
{% endif %}
