{% set sidebarWidth = sidebarExpanded() ? 'w-64' : 'w-16' %}
<aside{{ attributes.defaults({
    'id': 'sidebar',
    'class': block('sidebar_aside_classes', tbd_twig_component_template)|trim ~ ' ' ~ sidebarWidth,
    'data-sidebar-target': 'sidebar',
}) }}
        {% if sidebarHoverState() %}
            data-action="mouseenter->sidebar#onMouseEnter mouseleave->sidebar#onMouseLeave"
        {% endif %}
>
    <div class="{{ block('sidebar_wrapper_classes', tbd_twig_component_template)|trim }}">
        {% block content %}{% endblock %}
    </div>
</aside>
