<div {{ attributes.defaults({
    'id': 'toast',
    'role': 'alert',
    'class': block('toast_classes', tbd_twig_component_template)|trim ~ ' ' ~ this.colorClasses(),
}) }}
        {% if autoClose %}
            data-controller="closeable"
            data-closeable-auto-close-value="{{ timeUntilClose }}"
        {% endif %}
>
    <div class="inline-flex items-center justify-center {{ this.colorClasses() }}">
        {{ ux_icon(this.icon(), {'class': this.iconSizeClasses}) }}
    </div>
    <div class="text-sm font-normal">
        {% if message %}
            {{ message }}
        {% else %}
            {% block content %}{% endblock %}
        {% endif %}
    </div>
    {% set closeIcon %}{{ ux_icon('tbd:x', {'class': this.iconSizeClasses}) }}{% endset %}
    <twig:TBD:Button
            data-action="closeable#close"
            variant="{{ this.closeButtonVariant() }}" size="{{ this.closeButtonSize() }}" class="ms-auto"
            :label="closeIcon"/>
</div>
