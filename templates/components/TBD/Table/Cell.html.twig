<{{ tag }}{{ attributes.defaults({
    'class': block('table_cell', tbd_twig_component_template)|trim  ~ ' ' ~ (tag == 'th' ? block('table_head_cell', tbd_twig_component_template)|trim),
}) }}>
{% if value is defined and value is not null %}
    {{ value|raw }}
{% else %}
    {% block content %}{% endblock %}
{% endif %}
</{{ tag }}>
