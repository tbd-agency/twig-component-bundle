<{{ tag }}{{ attributes.defaults({
    'class': (actions ? block('table_action_cell_classes', tbd_twig_component_template)|trim ~ ' ' : '') ~ (tag == 'th' ? block('table_head_cell_classes', tbd_twig_component_template)|trim : block('table_cell_classes', tbd_twig_component_template)|trim),
}) }}>
{% if value is defined and value is not null %}
    {{ value|raw }}
{% else %}
    {% block content %}{% endblock %}
{% endif %}
</{{ tag }}>
