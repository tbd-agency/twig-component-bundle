<{{ tag }}{{ attributes.defaults({
    'class': (actions ? block('table_action_cell_classes', tbd_twig_component_template)|trim ~ ' ' : '') ~ (tag == 'th' ? block('table_head_sticky_cell_classes', tbd_twig_component_template)|trim : block('table_sticky_cell_classes', tbd_twig_component_template)|trim) ~ ' ' ~ this.positionClasses
}) }}>
{% if value is defined and value is not null %}
    {{ value|raw }}
{% else %}
    {%- block content -%}&nbsp;{%- endblock -%}
{% endif %}
</{{ tag }}>
