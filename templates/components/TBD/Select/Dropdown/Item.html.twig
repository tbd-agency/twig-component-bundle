<div{{ attributes }}>
    <li{% for name, value in this.attributes %} {{ name|e('html_attr') }}="{{ value }}"{% endfor %}>
        <span class="{{ block('select_dropdown_item_classes', tbd_twig_component_template)|trim }}">
            {% if modal %}
                {{ label }}
            {% else %}
                <form method="POST" target="{{ target }}" action="{{ action }}" data-turbo="{{ turbo ? 'true' : 'false' }}"
                      data-confirm="{{ confirm }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <label for="selectedItems" class="cursor-pointer">
                        {{ label }}
                        <input type="hidden" class="selectedItems" name="selectedItems">
                        <input type="hidden" class="selectAll" name="selectAll" value="0">
                    </label>
                </form>
            {% endif %}
        </span>
    </li>
</div>
