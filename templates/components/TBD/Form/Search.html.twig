{{ form_start(searchForm, {'method': 'GET', 'attr': {'class': 'search-form'}}) }}
<twig:TBD:Card class="{{ block('form_search_card_classes', tbd_twig_component_template)|trim }}">
    <div class="{{ block('form_search_form_wrapper_classes', tbd_twig_component_template)|trim }}">
        {% for row in searchForm.children %}
            {{ form_row(row, {'row_attr': {'class': block('form_search_form_row_classes', tbd_twig_component_template)|trim }}) }}
        {% endfor %}
    </div>
    <div class="{{ block('form_search_button_wrapper_classes', tbd_twig_component_template)|trim }}">
        <twig:TBD:Button label="{{ 'button.search'|trans({'default': 'Search'}, 'tbd-component') }}" extraClasses="{{ block('form_search_button_search_classes', tbd_twig_component_template)|trim }}"/>
        <twig:TBD:Button label="{{ 'button.reset'|trans({'default': 'Reset'}, 'tbd-component') }}" extraClasses="{{ block('form_search_button_reset_classes', tbd_twig_component_template)|trim }}" variant="hollow" type="reset" data-controller="reset-search" data-action="reset-search#reset"/>
    </div>
</twig:TBD:Card>
{{ form_end(searchForm) }}