<li>
    <a{{ attributes.defaults({'class':  block('dropdown_delete_classes', tbd_twig_component_template)|trim}) }}
            data-controller="modal delete"
            data-modal-target-value="modal-delete"
            data-delete-action-value="{{ action }}"
            data-delete-csrf-token-value="{{ csrf_token(id) }}"
            data-action="click->modal#setSrc click->app#dropdownClose click->delete#modal"
    >
        {% if label is defined and label is not empty %}
            {{ label }}
        {% else %}
            {{ 'label.delete'|trans({'default': 'Delete'}, 'tbd-component') }}
        {% endif %}
    </a>
</li>