<li{{ attributes }}>
    {% set dropdownContent %}
        {% block content %}{% endblock %}
    {% endset %}
    <twig:TBD:Dropdown
            id="{{ uuid }}"
            buttonVariant="{{ variant }}"
            dropdownPlacement="{{ placement }}"
            buttonIcon="{{ icon ?? null }}"
            buttonText="{{ buttonText }}"
            down="{{ down }}">
        <twig:TBD:Dropdown:UnorderedList>
            {{ dropdownContent }}
        </twig:TBD:Dropdown:UnorderedList>
    </twig:TBD:Dropdown>
</li>
