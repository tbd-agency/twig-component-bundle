<li>
    {% if label is defined and label is not empty %}
        <a{{ attributes.defaults({'class': block('dropdown_item_classes', tbd_twig_component_template)|trim}) }}{% if path is defined %} href="{{ path }}"{% endif %}{% if not turbo %} data-turbo="false"{% endif %}>
            {{ label }}
        </a>
    {% else %}
        {% block content %}{% endblock %}
    {% endif %}
</li>