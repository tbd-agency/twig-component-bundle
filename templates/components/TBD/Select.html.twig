{% set translatedItemsSelected = 'label.items-selected'|trans %}
{% set translatedSelectAll = 'label.select-all'|trans %}
{% set translatedRemoveSelection = 'label.remove-selection'|trans %}
{% set translatedSelected = 'label.selected'|trans %}
{% set labelItemsSelected = labelItemsSelected|default(translatedItemsSelected != 'label.items-selected' ? translatedItemsSelected : 'item(s) selected') %}
{% set labelSelectAll = labelSelectAll|default(translatedSelectAll != 'label.select-all' ? translatedSelectAll : 'select all?') %}
{% set labelRemoveSelection = labelRemoveSelection|default(translatedRemoveSelection != 'label.remove-selection' ? translatedRemoveSelection : 'remove selection?') %}
{% set labelSelected = labelSelected|default(translatedSelected != 'label.selected' ? translatedSelected : 'Selected') %}
<div {{ attributes.defaults({
    'role': 'alert',
    'data-select-items-target': 'alert',
    'class': block('select_classes', tbd_twig_component_template)|trim,
}) }}>
    <p class="{{ block('select_text_classes', tbd_twig_component_template)|trim }}">
        <span data-select-items-target="amount">0</span>
        {% if total is defined and total %}
            <span data-select-items-target="total" class="hidden">{{ total }}</span>
        {% endif %}
        <span>
            {{ labelItemsSelected }}&comma;
        </span>
        {% if total is defined and total %}
            <span data-select-items-target="selectAll"
                  class="{{ block('select_action_classes', tbd_twig_component_template)|trim }}"
                  data-action="click->select-items#selectAll">
                {{ labelSelectAll }}
            </span>
            <span data-select-items-target="removeAll"
                  class="{{ block('select_action_classes', tbd_twig_component_template)|trim }} hidden"
                  data-action="click->select-items#removeAll">
                {{ labelRemoveSelection }}
            </span>
        {% endif %}
    </p>
    {% set dropdownContent %}
        {% block content %}{% endblock %}
    {% endset %}
    <twig:TBD:Dropdown
            buttonText="{{ labelSelected }}"
            buttonVariant="{{ buttonVariant }}"
            :down="true"
            placement="{{ dropdownPlacement }}"
            id="select"
            class="text-sm"
            popper="{{ false }}">
        <twig:TBD:Dropdown:UnorderedList>
            {{ dropdownContent|raw }}
        </twig:TBD:Dropdown:UnorderedList>
    </twig:TBD:Dropdown>
</div>
