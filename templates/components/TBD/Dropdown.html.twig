<div{{ attributes.defaults({
    'data-controller': 'dropdown',
    'data-dropdown-target-value': uuid ~ '-dropdown',
    'data-dropdown-trigger-value': uuid ~ '-dropdown-trigger',
    'data-dropdown-placement-value': dropdownPlacement,
    'class': block('dropdown_classes', tbd_twig_component_template)|trim,
}) }}>
    {% block buttonContent %}
        <twig:TBD:Button id="{{ uuid }}-dropdown-trigger"
                         variant="{{ buttonVariant }}"
                         size="{{ buttonSize }}"
                         type="button"
                         class="{{ block('dropdown_button_classes', tbd_twig_component_template)|trim ~ ' ' ~ buttonClasses }}"
                         data-dropdown-target="{{ popper ? 'button' }}"
                         data-action="dropdown#toggle"
                         tooltip="{{ buttonTooltip }}">
            {% if buttonIcon is defined and buttonIcon %}
                {{ ux_icon(buttonIcon, {class: block('dropdown_button_icon_classes', tbd_twig_component_template)|trim ~ (buttonText is defined and buttonText is not empty  ? ' mr-2')}) }}
            {% endif %}
            {% if buttonText is defined and buttonText is not empty %}
                {{ buttonText }}
            {% endif %}
            {% if down is defined and down %}
                {{ ux_icon('tbd:angle-down', {class: block('dropdown_button_down_classes', tbd_twig_component_template)|trim ~ (buttonText is defined and buttonText is not empty  ? ' ml-2')}) }}
            {% endif %}
            {% if buttonBadge %}
                <div class="{{ block('dropdown_button_icon_classes', tbd_twig_component_template)|trim }}">
                    {{ buttonBadge }}
                </div>
            {% endif %}
        </twig:TBD:Button>
    {% endblock %}
    <div id="{{ uuid }}-dropdown" data-dropdown-target="{{ popper ? 'content' }}"
         class="{{ block('dropdown_content_classes', tbd_twig_component_template)|trim }}">
        {% block content %}{% endblock %}
    </div>
</div>