<div{{ attributes.defaults({'class': block('section_classes', tbd_twig_component_template)|trim}) }}>
    {% set content %}
        {% if indented %}
            <div class="{{ block('section_indent_classes', tbd_twig_component_template)|trim }}">
                {{ block('content') }}
            </div>
        {% else %}
            {{ block('content') }}
        {% endif %}
    {% endset %}
    {% if wrapper %}
        <div class="{{ this.paddingClasses ~ ' ' ~ block('section_wrapper_classes', tbd_twig_component_template)|trim ~ ' ' ~ (border ? block('section_wrapper_border_classes', tbd_twig_component_template)|trim : '') }}">
            {{ content|raw }}
        </div>
    {% else %}
        {{ content|raw }}
    {% endif %}
</div>