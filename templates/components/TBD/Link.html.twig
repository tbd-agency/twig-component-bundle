<a {{ attributes.defaults({
    href: href,
    class:  block('link', tbd_twig_component_template)|trim ,
}) }}>
    {% if prependIcon is defined and prependIcon %}
        {{ ux_icon(prependIcon, {class: this.iconSizeClasses ~ ' transition duration-100'}) }}
    {% endif %}
    <span class="link flex items-center {{ this.marginClasses }}">{{- label|raw -}}</span>
    {% if appendIcon is defined and appendIcon %}
        {{ ux_icon(appendIcon, {class: this.iconSizeClasses ~ ' transition duration-100'}) }}
    {% endif %}
</a>