{% set cellAttributes = attributes.defaults({
    'class': block('resizable_table_cell_classes', tbd_twig_component_template)|trim,
    'data-column': column,
    'data-width': width ?: false,
    'style': this.style,
}) %}
<twig:TBD:Table:Cell {{ ...cellAttributes }} :value="value">
    {{ block(outerBlocks.content) }}
</twig:TBD:Table:Cell>
