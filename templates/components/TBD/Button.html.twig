<{{ tag }}{{ attributes.defaults({
    'class': block('button_classes', tbd_twig_component_template)|trim ~ ' ' ~ extraClasses,
    'type': tag == 'button' ? type : false,
    'target': target ?: false,
}|merge(tooltip ? {
    'data-controller': 'tooltip',
    'data-tooltip-target-value': identifier,
    'data-tooltip-placement-value': 'bottom',
} : {})) }}>
{% if label is defined and label is not empty and icon is empty %}
    {{ label|raw }}
{% elseif icon is not null and label is defined %}
    {{ ux_icon(icon, {'class': this.iconSizeClasses}) }}
    {{ label|raw }}
{% elseif icon is not null and label is not defined %}
    {{ ux_icon(icon, {'class': this.iconSizeClasses}) }}
{% else %}
    {% block content %}{% endblock content %}
{% endif %}

{% if indicator %}
    <twig:TBD:Indicator variant="{{ indicatorVariant }}" label="{{ indicator }}"/>
{% endif %}

{% if spinner %}
    <twig:TBD:Spinner size="{{ iconSize }}" class="hidden group-[[busy]]:inline-block"/>
{% endif %}
</{{ tag }}>

{% if tooltip %}
    <twig:TBD:Tooltip identifier="{{ identifier }}" label="{{ tooltip }}"/>
{% endif %}
