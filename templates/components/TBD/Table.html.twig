{% set table %}
    <table{{ attributes.defaults({'class': block('table_classes', tbd_twig_component_template)|trim ~ (hasSearch ? ' rounded-t-none') ~ (hasTabs ? ' rounded-tl-none')}) }}>
        {% block content %}{% endblock %}
    </table>
{% endset %}

{% if includeWrapper %}
    <twig:TBD:Table:Wrapper hasSearch="{{ hasSearch }}" hasTabs="{{ hasTabs }}" isSticky="{{ isSticky }}">
        {{ table }}
    </twig:TBD:Table:Wrapper>
{% else %}
    {{ table }}
{% endif %}
